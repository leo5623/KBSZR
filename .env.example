# KBSZR 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== AI改写供应商 ====================
# 通义千问
TONGYI_API_KEY=your_tongyi_api_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Claude
CLAUDE_API_KEY=your_claude_api_key

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# 抖音豆包
DOUBAO_API_KEY=your_doubao_api_key

# ==================== TTS语音合成 ====================
# 阿里云TTS
ALIYUN_TTS_API_KEY=your_aliyun_tts_api_key

# 火山引擎TTS
VOLCENGINE_TTS_API_KEY=your_volcengine_tts_api_key

# ==================== 数字人 ====================
# 阿里云数字人
ALIYUN_DH_API_KEY=your_aliyun_digital_human_api_key

# 腾讯数字人
TENCENT_DH_API_KEY=your_tencent_dh_api_key

# ==================== 本地模型 (可选) ====================
# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Whisper
WHISPER_MODEL=base

# ==================== UI模式 ====================
# cyberpunk (默认) / web / classic
KBSZR_UI=cyberpunk